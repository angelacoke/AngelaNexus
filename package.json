{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus — 智能化全能代理系统",
  "scripts": {
    "test": "node --test",
    "compatibility:test": "node --test test/compatibility.test.js",
