    "verify": "npm run syntax:check && npm test",
    "upstream:check": "node scripts/check-upstream.mjs",
    "kernel:conformance": "node scripts/kernel-conformance.mjs",
    "kernel:runtime:test": "node --test test/kernel-runtime.test.js"
  },
  "engines": {
    "node": ">=20"
  },
