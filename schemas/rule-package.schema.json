{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://angelanexus.dev/schema/rule-package.schema.json",
  "title": "AngelaNexus Rule Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "schemaVersion", "source", "publisher", "createdAt", "updatedAt", "rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
    "version": {"type": "integer", "minimum": 1},
    "schemaVersion": {"const": 1},
    "source": {"enum": ["builtin", "platform", "user", "external"]},
    "publisher": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "minLength": 1},
    "updatedAt": {"type": "string", "minLength": 1},
    "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "keyId": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "matchType", "value", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
          "matchType": {"enum": ["domain", "domain-suffix", "domain-keyword", "ip-cidr", "geo", "application", "process", "port", "protocol"]},
          "value": {"type": "string", "minLength": 1},
          "action": {"enum": ["direct", "proxy", "reject", "dns", "tun", "chain"]},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100000}
        }
      }
    }
  }
}
