--- listener/inbound/mixed_lifecycle.go
+++ listener/inbound/mixed_lifecycle.go
@@ -0,0 +1,58 @@
+package inbound
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+)
+
+// namedMixedRegistry owns every named mixed generation once Listen starts,
+// including retired and partially-created generations. The default mixed-port
+// listener has a separate registry in listener/mixed and is not included here.
+var namedMixedRegistry struct {
+	sync.Mutex
+	generations map[*Mixed]struct{}
+}
+
+func registerNamedMixed(m *Mixed) {
+	namedMixedRegistry.Lock()
+	defer namedMixedRegistry.Unlock()
+	if namedMixedRegistry.generations == nil {
+		namedMixedRegistry.generations = make(map[*Mixed]struct{})
+	}
+	namedMixedRegistry.generations[m] = struct{}{}
+}
+
+// StopNamedMixed cancels and joins each named mixed TCP/UDP generation.
+// Failed closes, retained packets, write-backs and timed-out synchronous
+// handlers remain registered so a later call retries the same concrete owner.
+func StopNamedMixed(ctx context.Context) error {
+	namedMixedRegistry.Lock()
+	generations := make([]*Mixed, 0, len(namedMixedRegistry.generations))
+	for m := range namedMixedRegistry.generations {
+		generations = append(generations, m)
+	}
+	namedMixedRegistry.Unlock()
+
+	var errs []error
+	done := make(map[*Mixed]bool, len(generations))
+	for _, m := range generations {
+		if err := m.Close(); err != nil {
+			done[m] = true
+			errs = append(errs, fmt.Errorf("close named mixed %s: %w", m.Name(), err))
+		}
+	}
+	for _, m := range generations {
+		if err := m.WaitClosed(ctx); err != nil {
+			done[m] = true
+			errs = append(errs, fmt.Errorf("drain named mixed %s: %w", m.Name(), err))
+		}
+		if !done[m] {
+			namedMixedRegistry.Lock()
+			delete(namedMixedRegistry.generations, m)
+			namedMixedRegistry.Unlock()
+		}
+	}
+	return errors.Join(errs...)
+}
