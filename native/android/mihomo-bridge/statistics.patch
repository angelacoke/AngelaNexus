+// StartStatistics starts the periodic statistics sampler. It is safe to call
+// repeatedly; at most one sampler is active at a time.
+func (m *Manager) StartStatistics() {
+	m.lifecycleMu.Lock()
+	defer m.lifecycleMu.Unlock()
+	if m.running {
+		return
+	}
+	m.stop = make(chan struct{})
+	m.done = make(chan struct{})
+	m.running = true
+	go m.handle(m.stop, m.done)
+}
+
+// StopStatistics synchronously stops the sampler. Pending temp counters are
+// retained for a later start, while blip is cleared after the worker joins.
+func (m *Manager) StopStatistics() {
+	m.lifecycleMu.Lock()
+	if !m.running {
+		m.lifecycleMu.Unlock()
+		return
+	}
+	close(m.stop)
+	<-m.done
+	m.running = false
+	m.stop = nil
+	m.done = nil
+	m.uploadBlip.Store(0)
+	m.downloadBlip.Store(0)
+	m.lifecycleMu.Unlock()
+}
