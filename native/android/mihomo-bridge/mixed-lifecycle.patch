@@ -0,0 +1,127 @@
+package mixed
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"sync"
+)
+
+var listenerRegistry struct {
+	sync.Mutex
+	generations map[*Listener]struct{}
+}
+
+func registerListener(l *Listener) {
+	listenerRegistry.Lock()
+	if listenerRegistry.generations == nil {
+		listenerRegistry.generations = make(map[*Listener]struct{})
+	}
+	listenerRegistry.generations[l] = struct{}{}
+	listenerRegistry.Unlock()
+}
+
+// Only a pure net.ErrClosed (including wrappers/joins) acknowledges release.
+// errors.Is alone would also swallow an unrelated joined close failure.
+func onlyClosedError(err error) bool {
+	if err == net.ErrClosed {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		causes := joined.Unwrap()
+		if len(causes) == 0 {
+			return false
+		}
+		for _, cause := range causes {
+			if !onlyClosedError(cause) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyClosedError(wrapped.Unwrap())
+	}
+	return false
+}
+
+// Caller holds mu. A closed socket count is not proof that the accept loop or
+// handler has returned: only their exit acknowledgements can close drained.
+func (l *Listener) maybeDrained() {
+	if l.closed && l.acceptExited && l.handlers == 0 {
+		select {
+		case <-l.drained:
+		default:
+			close(l.drained)
+		}
+	}
+}
+
+func (l *Listener) untrack(c net.Conn) {
+	l.mu.Lock()
+	delete(l.conns, c)
+	l.handlers--
+	// Never delete pending here: a returning handler does not acknowledge a
+	// failed Close. That concrete connection remains a retry responsibility.
+	l.maybeDrained()
+	l.mu.Unlock()
+}
+
+func (l *Listener) acceptFinished() {
+	l.mu.Lock()
+	l.acceptExited = true
+	l.maybeDrained()
+	l.mu.Unlock()
+}
+
+// Own a late Accept result before attempting Close, including its error path.
+// closeMu serializes it with explicit Close retries without holding mu in I/O.
+func (l *Listener) rejectLate(c net.Conn) {
+	l.closeMu.Lock()
+	defer l.closeMu.Unlock()
+	l.mu.Lock()
+	l.pending[c] = struct{}{}
+	l.mu.Unlock()
+	err := c.Close()
+	if err == nil || onlyClosedError(err) {
+		l.mu.Lock()
+		delete(l.pending, c)
+		l.mu.Unlock()
+	}
+}
+
+// StopListeners owns only default/global mixed-port TCP generations, including
+// generations retired by reload. Cancel all before joining any under one shared
+// deadline. Failed close acknowledgements and timed-out handlers remain owned.
+// Handlers may still be inside a synchronous tunnel call when canceled; a timeout
+// retains their generation. This does not join other tunnel work or shut down
+// named inbounds, UDP, other protocols, or the complete kernel.
+func StopListeners(ctx context.Context) error {
+	listenerRegistry.Lock()
+	ls := make([]*Listener, 0, len(listenerRegistry.generations))
+	for l := range listenerRegistry.generations {
+		ls = append(ls, l)
+	}
+	listenerRegistry.Unlock()
+	failed := make(map[*Listener]bool)
+	var errs []error
+	for _, l := range ls {
+		if err := l.Close(); err != nil {
+			failed[l] = true
+			errs = append(errs, fmt.Errorf("close mixed TCP %s: %w", l.addr, err))
+		}
+	}
+	for _, l := range ls {
+		if err := l.WaitClosed(ctx); err != nil {
+			failed[l] = true
+			errs = append(errs, fmt.Errorf("drain mixed TCP %s: %w", l.addr, err))
+		}
+		if !failed[l] {
+			listenerRegistry.Lock()
+			delete(listenerRegistry.generations, l)
+			listenerRegistry.Unlock()
+		}
+	}
+	return errors.Join(errs...)
+}
