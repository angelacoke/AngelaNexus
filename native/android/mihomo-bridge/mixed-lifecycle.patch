--- listener/socks/udp_lifecycle.go
+++ listener/socks/udp_lifecycle.go
@@ -0,0 +1,177 @@
+package socks
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+
+	"github.com/metacubex/mihomo/adapter/inbound"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/socks5"
+)
+
+var udpRegistry struct {
+	sync.Mutex
+	generations map[*UDPListener]struct{}
+}
+
+func registerUDPMixed(l *UDPListener) {
+	udpRegistry.Lock()
+	if udpRegistry.generations == nil {
+		udpRegistry.generations = make(map[*UDPListener]struct{})
+	}
+	udpRegistry.generations[l] = struct{}{}
+	udpRegistry.Unlock()
+}
+
+func onlyClosedError(err error) bool {
+	if err == net.ErrClosed {
+		return true
+	}
+	if u, ok := err.(interface{ Unwrap() []error }); ok {
+		if len(u.Unwrap()) == 0 {
+			return false
+		}
+		for _, e := range u.Unwrap() {
+			if !onlyClosedError(e) {
+				return false
+			}
+		}
+		return true
+	}
+	if u, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyClosedError(u.Unwrap())
+	}
+	return false
+}
+
+// WaitClosed joins the UDP reader and all inline packet handlers.
+func (l *UDPListener) WaitClosed(ctx context.Context) error {
+	if l.drained == nil {
+		return nil
+	}
+	select {
+	case <-l.drained:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (l *UDPListener) maybeDrained() {
+	// Drain acknowledges reader/packet exit, not successful Close. The caller
+	// separately retains a failed close acknowledgement for retry.
+	if l.closed && l.readerDone && l.pending == 0 && l.writes == 0 {
+		select {
+		case <-l.drained:
+		default:
+			close(l.drained)
+		}
+	}
+}
+
+func (l *UDPListener) releasePacket() {
+	l.mu.Lock()
+	if l.pending > 0 {
+		l.pending--
+	}
+	l.maybeDrained()
+	l.mu.Unlock()
+}
+
+// StopMixedUDP cancels every snapshot generation before waiting on any of them.
+// A single context deadline is shared; timed-out or close-failed generations
+// remain registered for a later retry. Newly registered generations are not
+// retroactively owned by this snapshot.
+func StopMixedUDP(ctx context.Context) error {
+	udpRegistry.Lock()
+	ls := make([]*UDPListener, 0, len(udpRegistry.generations))
+	for l := range udpRegistry.generations {
+		ls = append(ls, l)
+	}
+	udpRegistry.Unlock()
+	var errs []error
+	failed := make(map[*UDPListener]bool)
+	for _, l := range ls {
+		if err := l.Close(); err != nil {
+			failed[l] = true
+			errs = append(errs, err)
+		}
+	}
+	for _, l := range ls {
+		select {
+		case <-l.drained:
+		case <-ctx.Done():
+			failed[l] = true
+			errs = append(errs, ctx.Err())
+		}
+		if !failed[l] {
+			udpRegistry.Lock()
+			delete(udpRegistry.generations, l)
+			udpRegistry.Unlock()
+		}
+	}
+	return errors.Join(errs...)
+}
+
+type mixedUDPPacket struct {
+	listener *UDPListener
+	pc       net.PacketConn
+	rAddr    net.Addr
+	payload  []byte
+	put      func()
+	once     sync.Once
+	release  func()
+}
+
+func (p *mixedUDPPacket) Data() []byte        { return p.payload }
+func (p *mixedUDPPacket) LocalAddr() net.Addr { return p.rAddr }
+func (p *mixedUDPPacket) InAddr() net.Addr    { return p.pc.LocalAddr() }
+func (p *mixedUDPPacket) WriteBack(b []byte, addr net.Addr) (int, error) {
+	l := p.listener
+	l.mu.Lock()
+	if l.closed {
+		l.mu.Unlock()
+		return 0, net.ErrClosed
+	}
+	// Drop acknowledges payload ownership, not relay write-back ownership.
+	l.writes++
+	l.mu.Unlock()
+	defer func() {
+		l.mu.Lock()
+		l.writes--
+		l.maybeDrained()
+		l.mu.Unlock()
+	}()
+	encoded, err := socks5.EncodeUDPPacket(socks5.ParseAddrToSocksAddr(addr), b)
+	if err != nil {
+		return 0, err
+	}
+	return p.pc.WriteTo(encoded, p.rAddr)
+}
+
+func (p *mixedUDPPacket) Drop() {
+	p.once.Do(func() {
+		p.payload = nil
+		if p.put != nil {
+			p.put()
+		}
+		p.release()
+	})
+}
+
+func handleMixedSocksUDP(l *UDPListener, tunnel C.Tunnel, buf []byte, put func(), addr net.Addr, additions ...inbound.Addition) {
+	target, payload, err := socks5.DecodeUDPPacket(buf)
+	if err != nil {
+		if put != nil {
+			put()
+		}
+		l.releasePacket()
+		return
+	}
+	p := &mixedUDPPacket{listener: l, pc: l.packetConn, rAddr: addr, payload: payload, put: put, release: l.releasePacket}
+	// The packet remains owned by the generation until the tunnel calls Drop;
+	// no forced Drop is attempted when a handler has retained Data().
+	tunnel.HandleUDPPacket(inbound.NewPacket(target, p, C.SOCKS5, additions...))
+}
