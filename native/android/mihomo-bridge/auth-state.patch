--- adapter/inbound/auth_state.go
+++ adapter/inbound/auth_state.go
@@ -0,0 +1,50 @@
+package inbound
+
+import (
+	"net/netip"
+	"sync"
+
+	"github.com/metacubex/mihomo/component/auth"
+)
+
+// AuthSnapshot is an immutable, generation-consistent admission view.
+type AuthSnapshot struct {
+	Authenticator    auth.Authenticator
+	SkipAuthPrefixes []netip.Prefix
+	AllowedIPs       []netip.Prefix
+	DisAllowedIPs    []netip.Prefix
+}
+
+var authState struct {
+	mu                sync.RWMutex
+	authenticator     auth.Authenticator
+	skip, allow, deny []netip.Prefix
+}
+
+func clonePrefixes(v []netip.Prefix) []netip.Prefix { return append([]netip.Prefix(nil), v...) }
+func AuthSnapshotNow() AuthSnapshot {
+	authState.mu.RLock()
+	defer authState.mu.RUnlock()
+	return AuthSnapshot{authState.authenticator, clonePrefixes(authState.skip), clonePrefixes(authState.allow), clonePrefixes(authState.deny)}
+}
+
+// ApplyAuthState publishes users and all admission filters as one generation.
+func ApplyAuthState(users []auth.AuthUser, skip, allow, deny []netip.Prefix) {
+	a := auth.NewAuthenticator(append([]auth.AuthUser(nil), users...))
+	authState.mu.Lock()
+	authState.authenticator = a
+	authState.skip = clonePrefixes(skip)
+	authState.allow = clonePrefixes(allow)
+	authState.deny = clonePrefixes(deny)
+	authState.mu.Unlock()
+}
+func SetDefaultAuthenticator(a auth.Authenticator) {
+	authState.mu.Lock()
+	authState.authenticator = a
+	authState.mu.Unlock()
+}
+func DefaultAuthenticator() auth.Authenticator {
+	authState.mu.RLock()
+	defer authState.mu.RUnlock()
+	return authState.authenticator
+}
