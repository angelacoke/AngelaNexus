+// One attempt owns both raw closes, including dependencies that ignore Close.
+// Timeout does not abandon these workers or start another attempt on retry.
+// A completed failure can be retried; successful socket retirement is cached.
+type socks5SocketClose struct {
+	done chan struct{}
+	err  error // published by closing done
+}
+
+func (uc *socksPacketConn) beginSocketClose() *socks5SocketClose {
+	uc.closeMu.Lock()
+	defer uc.closeMu.Unlock()
+	if previous := uc.closeAttempt; previous != nil {
+		select {
+		case <-previous.done:
+			if previous.err == nil {
+				return previous
+			}
+		default:
+			return previous
+		}
+	}
+	attempt := &socks5SocketClose{done: make(chan struct{})}
+	uc.closeAttempt = attempt
+	// Try both independently: a stuck TCP Close must not skip UDP retirement.
+	tcpDone := make(chan error, 1)
+	udpDone := make(chan error, 1)
+	go func() { tcpDone <- uc.tcpConn.Close() }()
+	go func() { udpDone <- uc.PacketConn.Close() }()
+	go func() {
+		tcpErr, udpErr := <-tcpDone, <-udpDone
+		if socks5ClosedOnly(tcpErr) {
+			tcpErr = nil
+		}
+		if socks5ClosedOnly(udpErr) {
+			udpErr = nil
+		}
+		attempt.err = errors.Join(tcpErr, udpErr)
+		close(attempt.done)
+	}()
+	return attempt
+}
+
+// Wait for raw socket closes AND final monitor cleanup under one deadline.
+// Never discard the attempt/completion owner on timeout or a real close error.
+func (uc *socksPacketConn) closeWithContext(ctx context.Context) error {
+	attempt := uc.beginSocketClose()
+	select {
+	case <-attempt.done:
+	default:
+		select {
+		case <-attempt.done:
+		case <-ctx.Done():
+			return fmt.Errorf("SOCKS5 UDP socket cleanup: %w", ctx.Err())
+		}
+	}
+	if attempt.err != nil {
+		return attempt.err
+	}
+	select {
+	case <-uc.monitorDone:
+		return nil
+	default:
+	}
+	select {
+	case <-uc.monitorDone:
+		return nil
+	case <-ctx.Done():
+		return fmt.Errorf("SOCKS5 UDP control monitor cleanup: %w", ctx.Err())
+	}
+}
