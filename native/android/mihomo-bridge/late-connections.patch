+// Registration returns the setup generation and a context canceled by
+// StopRegistrations. The shared context owns no per-handler registration.
+func (m *Manager) Registration() (uint64, context.Context) {
+	m.registrationMu.Lock()
+	if m.registrationGen == nil {
+		ctx, cancel := context.WithCancel(context.Background())
+		if !m.registrationOpen {
+			cancel()
+		}
+		m.registrationGen = &registrationGeneration{epoch: m.registrationEpoch, ctx: ctx, cancel: cancel}
+	}
+	gen := m.registrationGen
+	m.registrationMu.Unlock()
+	return gen.epoch, gen.ctx
+}
+
+// RegistrationEpoch is retained for callers that only need an admission token.
+func (m *Manager) RegistrationEpoch() uint64 {
+	epoch, _ := m.Registration()
+	return epoch
+}
+
+// StopRegistrations invalidates old setup tokens and cancels their context.
+// Cancellation is deliberately invoked after releasing registrationMu because
+// context cancellation runs arbitrary waiting callbacks synchronously.
+func (m *Manager) StopRegistrations() {
+	m.registrationMu.Lock()
+	m.registrationEpoch++
+	m.registrationOpen = false
+	gen := m.registrationGen
+	m.registrationGen = nil
+	m.registrationMu.Unlock()
+	if gen != nil {
+		gen.cancel()
+	}
+}
+
+func (m *Manager) StartRegistrations() {
+	m.registrationMu.Lock()
+	if m.registrationOpen {
+		m.registrationMu.Unlock()
+		return
+	}
+	m.registrationOpen = true
+	ctx, cancel := context.WithCancel(context.Background())
+	m.registrationGen = &registrationGeneration{epoch: m.registrationEpoch, ctx: ctx, cancel: cancel}
+	m.registrationMu.Unlock()
+}
+
+var errRegistrationStopped = errors.New("statistics registration epoch closed")
+
+// BeginSetup admits one ordinary dial/retry/early-handshake operation in the
+// current registration generation. Its release is safe to call repeatedly.
+func (m *Manager) BeginSetup(epoch uint64) (func(), error) {
+	m.registrationMu.Lock()
+	if !m.registrationOpen || epoch != m.registrationEpoch {
+		m.registrationMu.Unlock()
+		return nil, errRegistrationStopped
+	}
+	if m.setupCount == 0 {
+		m.setupDrain = make(chan struct{})
+	}
+	m.setupCount++
+	drain := m.setupDrain
+	m.registrationMu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			m.registrationMu.Lock()
+			if m.setupCount > 0 {
+				m.setupCount--
+				if m.setupCount == 0 && m.setupDrain == drain {
+					close(drain)
+					m.setupDrain = nil
+				}
+			}
+			m.registrationMu.Unlock()
+		})
+	}, nil
+}
+
+// WaitSetups waits for all admitted setup operations after registration closes.
+// The channel snapshot and context select are deliberately outside the mutex.
+func (m *Manager) WaitSetups(ctx context.Context) error {
+	m.registrationMu.Lock()
+	if m.registrationOpen {
+		m.registrationMu.Unlock()
+		return errors.New("statistics registrations are still open")
+	}
+	drain := m.setupDrain
+	m.registrationMu.Unlock()
+	if drain == nil {
+		return nil
+	}
+	select {
+	case <-drain:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// JoinAtEpoch transfers ownership even on rejection. A rejected result is
+// closed outside the gate lock; genuine failures remain visible to Range for
+// the bridge's next cleanup. ID and Close can re-enter upstream code.
+func (m *Manager) JoinAtEpoch(epoch uint64, c Tracker) error {
+	id := c.ID()
+	m.registrationMu.Lock()
+	if m.registrationOpen && epoch == m.registrationEpoch {
+		m.connections.Store(id, c)
+		m.registrationMu.Unlock()
+		return nil
+	}
+	m.registrationMu.Unlock()
+	if err := c.Close(); err != nil && !registrationClosedOnly(err) {
+		m.connections.Store(id, c)
+		return errors.Join(errRegistrationStopped, err)
+	}
+	return errRegistrationStopped
+}
+
+func registrationClosedOnly(err error) bool {
+	if err == net.ErrClosed {
+		return true
+	}
+	if many, ok := err.(interface{ Unwrap() []error }); ok {
+		children := many.Unwrap()
+		if len(children) == 0 {
+			return false
+		}
+		for _, child := range children {
+			if !registrationClosedOnly(child) {
+				return false
+			}
+		}
+		return true
+	}
+	if one, ok := err.(interface{ Unwrap() error }); ok {
+		return registrationClosedOnly(one.Unwrap())
+	}
+	return false
 }
 
