+type serverResource struct {
+	mu       sync.Mutex
+	raw      io.Closer
+	inflight chan struct{}
+	released bool
+	err      error
+}
+
+func (r *serverResource) install(raw io.Closer) { r.mu.Lock(); r.raw = raw; r.mu.Unlock() }
+func serverClosedOnly(err error) bool {
+	if err == net.ErrClosed {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		causes := joined.Unwrap()
+		if len(causes) == 0 {
+			return false
+		}
+		for _, cause := range causes {
+			if !serverClosedOnly(cause) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return serverClosedOnly(wrapped.Unwrap())
+	}
+	return false
+}
+func (r *serverResource) close(ctx context.Context) error {
+	r.mu.Lock()
+	if r.raw == nil || r.released {
+		r.mu.Unlock()
+		return nil
+	}
+	done := r.inflight
+	if done == nil {
+		done = make(chan struct{})
+		r.inflight = done
+		raw := r.raw
+		go func() {
+			err := raw.Close()
+			if serverClosedOnly(err) {
+				err = nil
+			}
+			r.mu.Lock()
+			r.err = err
+			r.released = err == nil
+			r.inflight = nil
+			close(done)
+			r.mu.Unlock()
+		}()
+	}
+	r.mu.Unlock()
+	select {
+	case <-done:
+		r.mu.Lock()
+		err := r.err
+		r.mu.Unlock()
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
