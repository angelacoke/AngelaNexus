 func (t *Table) Delete(key string) {
 	t.mapping.Delete(key)
+}
+
+// detachIf compares ownership and removes a single key under the same bucket
+// lock. Only the detached entry can be cleaned, never a later replacement.
+func (t *Table) detachIf(key string, sender C.PacketSender) *entry {
+	var detached *entry
+	t.mapping.Compute(key, func(current *entry, loaded bool) (*entry, xsync.ComputeOp) {
+		if loaded && current.PacketSender == sender {
+			detached = current
+			return nil, xsync.DeleteOp
+		}
+		return current, xsync.CancelOp
+	})
+	return detached
+}
+
+// DeleteIf removes key only when it still belongs to sender.
+func (t *Table) DeleteIf(key string, sender C.PacketSender) bool {
+	return t.detachIf(key, sender) != nil
+}
+
+// DetachLocalConnsIf removes only the sender-owned entry, then snapshots its
+// local sockets outside the table lock. Callers close only those sockets.
+// This does not join local-connection creators already holding that entry.
+func (t *Table) DetachLocalConnsIf(key string, sender C.PacketSender) []*net.UDPConn {
+	item := t.detachIf(key, sender)
+	if item == nil {
+		return nil
+	}
+	var conns []*net.UDPConn
+	item.LocalUDPConnMap.Range(func(remote string, conn *net.UDPConn) bool {
+		conns = append(conns, conn)
+		return true
+	})
+	return conns
 }
 
