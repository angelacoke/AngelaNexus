+// errors.Is alone would also match Join(net.ErrClosed, realFailure), silently
+// discarding a failed cleanup. Normalize only trees made entirely of closed.
+func socks5ClosedOnly(err error) bool {
+	if err == net.ErrClosed {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		children := joined.Unwrap()
+		if len(children) == 0 {
+			return false
+		}
+		for _, child := range children {
+			if !socks5ClosedOnly(child) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return socks5ClosedOnly(wrapped.Unwrap())
+	}
+	return false
+}
