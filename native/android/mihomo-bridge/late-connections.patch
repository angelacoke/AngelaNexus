+// Each Exchange owns one exact connection. No watcher reads globalSrv or a
+// mutable service socket; a retired exchange cannot close its replacement.
+type exchangeDialer struct {
+	base      proxydialer.SingDialer
+	ctx       context.Context
+	mu        sync.Mutex
+	conn      net.Conn
+	dialed    bool
+	stopWatch func() bool
+	watchDone chan struct{}
+	inflight  chan struct{}
+	attempted bool
+	released  bool
+	err       error
+	reported  bool
+}
+type exchangeConn struct {
+	net.Conn
+	owner *exchangeDialer
+}
+
+func (c *exchangeConn) Close() error { return c.owner.Close() }
+func newExchangeDialer(base proxydialer.SingDialer, ctx context.Context) *exchangeDialer {
+	return &exchangeDialer{base: base, ctx: ctx}
+}
+func (d *exchangeDialer) ListenPacket(ctx context.Context, dst M.Socksaddr) (net.PacketConn, error) {
+	return d.base.ListenPacket(ctx, dst)
+}
+func (d *exchangeDialer) DialContext(ctx context.Context, network string, dst M.Socksaddr) (net.Conn, error) {
+	d.mu.Lock()
+	if d.dialed {
+		d.mu.Unlock()
+		return nil, errors.New("NTP exchange dial already used")
+	}
+	d.dialed = true
+	d.mu.Unlock()
+	conn, err := d.base.DialContext(ctx, network, dst)
+	// Even a non-nil connection returned with an error remains owned.
+	if conn == nil {
+		if err == nil {
+			err = errors.New("NTP dial returned no connection")
+		}
+		return nil, err
+	}
+	d.mu.Lock()
+	d.conn = conn
+	d.watchDone = make(chan struct{})
+	watchDone := d.watchDone
+	d.stopWatch = context.AfterFunc(d.ctx, func() {
+		d.beginClose(false)
+		close(watchDone)
+	})
+	d.mu.Unlock()
+	if err != nil || d.ctx.Err() != nil {
+		closeErr := d.Close()
+		return nil, errors.Join(err, d.ctx.Err(), closeErr)
+	}
+	return &exchangeConn{Conn: conn, owner: d}, nil
