+// runVLESSTasksAndWait keeps the final two transfer tasks joined after task.Run
+// returns early. This is intentionally local to VLESS Process: the common task
+// runner returns the first error without waiting for its sibling.
+func runVLESSTasksAndWait(ctx context.Context, cancel, newCancel context.CancelFunc,
+	conn common.Closable, reader, writer interface{}, first, second func() error) error {
+	var wg sync.WaitGroup
+	wg.Add(2)
+	run := func(f func() error) func() error {
+		return func() error {
+			defer wg.Done()
+			return f()
+		}
+	}
+	defer func() {
+		cancel()
+		if newCancel != nil {
+			newCancel()
+		}
+		_ = common.Close(conn)
+		_ = common.Interrupt(reader)
+		_ = common.Interrupt(writer)
+		wg.Wait()
+	}()
+	return task.Run(ctx, run(first), run(second))
+}
